# ============================================================================
#  BCOE Blockchain Attendance System - environment configuration
#  Copy to `.env` and edit. Everything here is OPTIONAL: with no .env at all
#  the project runs on the local JSON store with an auto-selected anchor
#  provider, which is the right default for a college lab machine.
# ============================================================================

# ---------------------------------------------------------------- storage ---
# auto | firestore | local
#   auto      -> use Firestore when fully configured, otherwise the local file
#   firestore -> require Firestore (falls back to local with a warning)
#   local     -> always use data/attendance_ledger.json
STORAGE_BACKEND=auto

# Set these to enable Google Cloud Firestore.
# 1. Firebase console -> Project settings -> Service accounts
# 2. "Generate new private key" and save the JSON as firebase-service-account.json
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
FIRESTORE_DATABASE=(default)
# Optional namespace, e.g. FIRESTORE_PREFIX=staging
FIRESTORE_PREFIX=

# ---------------------------------------------------------------- sharing ---
# Push whatever is in the local file up to Firestore on first connect.
# Useful when you demoed offline and later add cloud credentials.
AUTO_SYNC_LOCAL_TO_CLOUD=true

# ------------------------------------------------------------------ chain ---
# Leading hexadecimal zeros a block hash must have. 1-4 seals instantly;
# 5-6 visibly mines for a second or two (good for a live demo).
CHAIN_DIFFICULTY=4
# Seal a block once this many marks are waiting.
CHAIN_SEAL_THRESHOLD=25
CHAIN_NODE_NAME=BCOE-NODE-01

# -------------------------------------------------------------- attendance ---
# Seconds a rotating QR token stays valid. Lower = harder to screenshot-share.
QR_TOKEN_TTL=30
# Marks after this many seconds become LATE instead of PRESENT.
GRACE_SECONDS=300
# Optional campus geofencing (off by default; enable for the stricter demo)
REQUIRE_GEOFENCE=false
GEOFENCE_RADIUS_M=250

# --------------------------------------------------------------- anchoring ---
# auto | opentimestamps | ethereum | simulated
#   auto -> try OpenTimestamps, fall back to a clearly-labelled simulated anchor
ANCHOR_PROVIDER=auto
# Set true to actually broadcast (Ethereum) rather than just prepare the payload.
ANCHOR_SUBMIT_ENABLED=false
# Sepolia testnet by default; get free test ETH from a public faucet.
ETHEREUM_RPC_URL=
ETHEREUM_CONTRACT=
ETHEREUM_PRIVATE_KEY=
# 1 = mainnet, 11155111 = Sepolia, 137 = Polygon, 80002 = Polygon Amoy
ETHEREUM_CHAIN_ID=11155111

# ------------------------------------------------------------------- app ----
APP_DEBUG=false
HOST=0.0.0.0
PORT=8000
# Change this before deploying anywhere real.
SECRET_KEY=bcoe-attendance-chain-dev-secret
ACADEMIC_YEAR=2026-27
