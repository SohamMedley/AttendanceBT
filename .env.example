# Copy to .env for local use. Every value is optional.

# Used to sign the QR tokens and the session cookie.
SECRET_KEY=change-me-to-any-long-random-string

# auto  = Firestore if credentials are below, otherwise the local JSON file
# local = always the JSON file at DATA_FILE
STORAGE_BACKEND=auto
DATA_FILE=data/ledger.json

# Firebase (only needed in the cloud). The service account may be the JSON
# itself or a path to the JSON file.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=

# Leading zeros required in a block hash.
CHAIN_DIFFICULTY=4

# How long one QR code stays valid, in seconds.
QR_TOKEN_TTL=30

ACADEMIC_YEAR=2026-27
PORT=5000
APP_DEBUG=false
